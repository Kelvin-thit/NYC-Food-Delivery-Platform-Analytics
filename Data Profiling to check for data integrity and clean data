FROM orders 
GROUP BY channel 
ORDER BY order_count desc 
limit 10; 

--NULL check customers--
SELECT 
 SUM(CASE WHEN first_name IS NULL OR TRIM(first_name) = '' THEN 1 ELSE 0 END) AS  null_first_name, 
 SUM(CASE WHEN last_name IS NULL OR TRIM(last_name) = '' THEN 1 ELSE 0 END) AS  null_last_name, 
 SUM(CASE WHEN email IS NULL OR TRIM(email) = '' THEN 1 ELSE 0 END) AS null_email,  SUM(CASE WHEN phone_number IS NULL OR TRIM(phone_number) = '' THEN 1 ELSE 0  END) AS null_phone 
FROM customers; 


--Orders with 2 occurances--
 SELECT
    order_id,
    LOWER(TRIM(status))   AS status,
    COUNT(*)              AS times_recorded,
    MIN(event_ts)         AS first_occurrence,
    MAX(event_ts)         AS last_occurrence
FROM status_events
GROUP BY order_id, LOWER(TRIM(status))
HAVING COUNT(*) > 1
ORDER BY times_recorded DESC;
